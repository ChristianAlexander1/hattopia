# Copy to .env (optional). The server reads these from the environment.
# Port to listen on.
PORT=8080
# Interface to bind (0.0.0.0 = all interfaces; 127.0.0.1 = localhost only).
HOST=0.0.0.0
# Override the SQLite database path (default: <repo>/data/game.db).
# Useful for staging or for pointing at a mounted persistent volume.
SPROUT OPIA_DB=
